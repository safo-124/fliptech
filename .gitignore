# Secrets
# SSH keys must never land here. ssh-keygen writes to the current directory
# if you give it a bare filename instead of a path, which is easy to do and
# would otherwise leave a private key one `git add -A` away from GitHub.
id_rsa
id_ecdsa
id_ed25519
*.pem
*.key
*_rsa
*_ed25519
!*.pub.example

.env
.env.*
# Match every *.example template, not just .env.example — .env.*
# swallowed .env.production.example, so DEPLOY.md told people to copy a file
# that was never in the repo.
!.env*.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3

# Node
node_modules/
.next/
*.tsbuildinfo
out/
.turbo/
.playwright-results/
playwright-report/

# Media and static
/backend/media/
/backend/staticfiles/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
