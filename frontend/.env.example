# Brand name shown to users. One value, so an ORC name change is one edit.
NEXT_PUBLIC_BRAND_NAME=Fliptech

# Django API. In development the backend runs inside WSL and the frontend on
# Windows; WSL2 forwards localhost, so 127.0.0.1 works from both sides.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public bucket hostname in production, for next/image remotePatterns.
NEXT_PUBLIC_MEDIA_HOST=

# Map tiles. The defaults use OpenStreetMap only for local development; set a
# production tile service and the exact attribution required by that provider.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
