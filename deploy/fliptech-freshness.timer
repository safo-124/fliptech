# Nightly, before the field team starts, so the queue is ready in the morning.
# Persistent= catches up after the server was off at 05:00.
[Unit]
Description=Nightly 90-day freshness prompt queue

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
