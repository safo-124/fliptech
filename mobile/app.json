{
  "expo": {
    "name": "Fliiptech",
    "slug": "fliiptech",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fliiptech",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbf9f5",
    "android": {
      "package": "com.fliiptech.skillshub",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#26005a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fliiptech uses your location to show training workshops near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#26005a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
