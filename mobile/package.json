  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/geojson": "7946.0.16",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "30.5.2",
    "jest-expo": "^58.0.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "export:android": "expo export --platform android"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|lucide-react-native|standard-navigation|supercluster|kdbush)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^react-native-reanimated$": "<rootDir>/test/reanimated.ts",
      "^react-native-reanimated/mock$": "<rootDir>/test/reanimated-mock.ts"
    }
  }
}
