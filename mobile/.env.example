# Copy to .env (never committed) and set the address the phone can reach.
#
# Phone on the same Wi-Fi as your computer: your computer's address, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
# Android emulator: 10.0.2.2 is the computer it runs on.
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# The staging server:
#   EXPO_PUBLIC_API_URL=https://135.181.93.156.nip.io
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# The website, for pages the app opens there until it has its own.
EXPO_PUBLIC_SITE_URL=http://10.0.2.2:3000

# Map tiles (optional). Without these the map uses OpenStreetMap's own
# tiles, fine for testing; OpenStreetMap asks apps to use a provider for
# real use. The same raster address as the website's NEXT_PUBLIC_MAP_TILE_URL:
#   EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
#   EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
