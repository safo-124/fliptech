# Copy to .env and fill in. .env is gitignored; this file is not.
# Read by django-environ.

# --- Brand ---
# Appears in the back office, every SMS and the WhatsApp handover text.
BRAND_NAME=Fliptech

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Note the postgis:// scheme, not postgres://. django-environ maps it to
# django.contrib.gis.db.backends.postgis, which is what PointField needs.
DATABASE_URL=postgis://skillshub:PASSWORD@localhost:5432/skillshub

# --- Cache and queue ---
REDIS_URL=redis://localhost:6379/0

# --- Media storage (Cloudflare R2, S3-compatible) ---
# TWO buckets by design: public workshop photographs, and private verification
# evidence and owner identification served only via short-lived signed URLs.
# See DATA_MODEL.md, ProviderMedia.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=skillshub-media
R2_BUCKET_PRIVATE=skillshub-evidence
R2_ENDPOINT_URL=

# --- SMS (Arkesel or Hubtel) ---
# "console" logs the code instead of sending it, which is what development and
# CI should use. Switch to arkesel or hubtel only once a sender ID is
# registered — that takes days to weeks and needs business documents. Those
# backends raise rather than silently no-op, so a misconfigured production
# deploy fails at the first enquiry instead of swallowing every code.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=SkillsHub

# --- WhatsApp Cloud API (Meta) ---
# Business verification takes weeks. Template messages are billed per message.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Error monitoring ---
SENTRY_DSN=
